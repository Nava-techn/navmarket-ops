# Session 1, lab S1.5: settings for scripts/session-01/s1.5-retry-launch.sh
# Copy to ~/oci-retry/navmarket.env, fill in your values, then: chmod 600 ~/oci-retry/navmarket.env
# Never commit the real file.
COMPARTMENT_ID="ocid1.tenancy.oc1..<YOUR_TENANCY_OCID>"     # root compartment = tenancy OCID
AD="<PREFIX>:EU-PARIS-1-AD-1"                                # oci iam availability-domain list
SUBNET_ID="ocid1.subnet.oc1.eu-paris-1.<YOUR_SUBNET_OCID>"   # public subnet of your VCN
IMAGE_A1="ocid1.image.oc1.eu-paris-1.<UBUNTU_MINIMAL_AARCH64>"  # image for VM.Standard.A1.Flex
IMAGE_E2=""                                                  # optional: x86_64 image for VM.Standard.E2.1.Micro
