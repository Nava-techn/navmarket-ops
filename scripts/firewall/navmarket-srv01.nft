#!/usr/sbin/nft -f
# Created in Session 4, lab S4.4: srv01 firewall, only 22, 80, 443 open.
# Installed as /etc/nftables.d/navmarket.nft by scripts/firewall/s4.4-firewall.sh
# Re-loading it is safe: the table is created, deleted, then rebuilt.

table inet navmarket_fw
delete table inet navmarket_fw

table inet navmarket_fw {
    set lab_lan {                       # the libvirt network of my workstation
        type ipv4_addr; flags interval
        elements = { 192.168.122.0/24 }
    }

    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept   # answers to connections already allowed
        ct state invalid drop
        iif lo accept                          # local services talk to each other
        meta l4proto { icmp, ipv6-icmp } accept  # ping, and IPv6 needs ICMPv6 to work

        tcp dport { 22, 80, 443 } accept       # SSH, HTTP, HTTPS: the 3 public ports
        ip saddr @lab_lan udp dport 53 accept  # DNS from S4.1, only for my lab network
        ip saddr @lab_lan tcp dport 53 accept

        limit rate 5/minute log prefix "nft-drop: "   # trace what is dropped (journalctl -k)
    }
}
