# S2.2 - systemd service that restarts on its own
# Install: /etc/systemd/system/navmarket-heartbeat.service
[Unit]
Description=NavMarket heartbeat (checks the storefront every 10 s)
After=network-online.target nginx.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/navmarket-heartbeat.sh
# Restart whatever the reason it stopped (crash, kill), 5 s later
Restart=always
RestartSec=5
# Runs as a temporary unprivileged user, not root
DynamicUser=yes

[Install]
WantedBy=multi-user.target
